{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "meta": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "sections": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "roster": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "records": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$key": {
        ".read": true,
        ".validate": "newData.hasChildren(['id', 'name', 'sec']) && newData.child('name').isString() && newData.child('name').val().length < 200",
        "s": {
          "$item": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 20)"
          }
        }
      }
    }
  }
}
