{
  "name": "grade-portal-react",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Students view their own grades; the teacher edits them. React + Supabase, hosted on Firebase Hosting.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.js",
    "check-workbook": "node scripts/check-workbook.mjs",
    "deploy": "vite build && firebase deploy --only hosting",
    "migrate-data": "node scripts/firebase-to-sql.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "^15.34.2",
    "jsdom": "^24.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
